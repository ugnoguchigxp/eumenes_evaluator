{
	"name": "eumenes-evaluator",
	"version": "0.1.0",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"exports": "./src/index.ts",
	"files": [
		"src",
		"examples",
		"vendor/steer",
		"README.md"
	],
	"scripts": {
		"quick": "bun src/cli.ts",
		"typecheck": "bun check",
		"verify": "bun run typecheck && bun test",
		"bench": "bun src/bench/cli.ts",
		"lint": "oxlint --deny-warnings src test",
		"format": "bun fmt src test",
		"format:check": "bun fmt --check src test",
		"bench:check": "bun run bench check && bun run bench check --suite examples/calibration-suite.json && bun run bench check --suite examples/final-suite.json && bun run bench check --suite examples/depth-suite.json && bun run bench check --suite examples/multi-evidence-suite.json"
	},
	"dependencies": {
		"eumenes-steer": "file:vendor/steer/eumenes-steer-0.1.0-1ca04b8bee9b.tgz",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@modelcontextprotocol/sdk": "1.31.0",
		"@openai/codex-sdk": "0.160.0",
		"@types/bun": "1.3.14",
		"oxlint": "1.86.0",
		"typescript": "7.0.2"
	},
	"private": true
}
